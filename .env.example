# Configurações do Supabase para Sincronização em Nuvem
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here

# Configurações do RevenueCat (PWA, Android e iOS)
# Obtenha estas chaves públicas em: https://app.revenuecat.com -> Project Settings -> API Keys
VITE_REVENUECAT_WEB_KEY=rcb_sb_... # Chave Web Billing (Stripe)
VITE_REVENUECAT_IOS_KEY=appl_...   # Chave iOS App Store (para quando compilar nativo)
VITE_REVENUECAT_ANDROID_KEY=goog_... # Chave Google Play (para quando compilar nativo)
VITE_REVENUECAT_ENTITLEMENT_ID=pro # Identificador do Entitlement no RevenueCat (padrão: pro)
